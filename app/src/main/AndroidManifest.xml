<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".IshiReaderApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.IshiReader"
        android:usesCleartextTraffic="true">
        <!--
          usesCleartextTraffic is on because the server this app talks to is a self-hosted
          Ishi-Read instance whose address the user supplies at runtime (often a bare LAN
          IP without TLS); see Ishi-Read's own README note about needing a reverse proxy
          for HTTPS. Tighten this with a network_security_config once a fixed, HTTPS-only
          deployment is the norm.
        -->

        <!-- IshiReaderApp supplies its own WorkManager Configuration (a custom WorkerFactory that
             injects PositionDao/NetworkModule into PositionSyncWorker), which requires turning off
             WorkManager's default auto-initializer -- otherwise the default Configuration wins the
             race and PositionSyncWorker can't be instantiated. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.IshiReader.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".reader.ReaderActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
    </application>

</manifest>
